{
  "name": "vidyanidhi",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "landing", "applicant-portal", "admin-portal"],
  "scripts": {
    "backend:dev": "node backend/node/dev-server.mjs",
    "backend:test": "node --test backend/test/flow.test.mjs backend/test/phase2.test.mjs",
    "backend:bundle": "node scripts/build-backend.mjs",
    "dev:landing": "npm run dev --workspace landing",
    "dev:applicant": "npm run dev --workspace applicant-portal",
    "dev:admin": "npm run dev --workspace admin-portal",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint landing/src applicant-portal/src admin-portal/src shared"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}

