      };
      P.db.insert('Invitations', inv);
    }
    if (inv.checked_in_at) return { token: inv.token, already: true };
    const token = giveToken(event);
    P.db.update('Invitations', inv.id, { checked_in_at: isoNow(), token, attendance: 'present' });
    return { token };
  }),
};

ACTIONS['event.mark'] = {
