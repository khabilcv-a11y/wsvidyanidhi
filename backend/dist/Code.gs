ACTIONS['admin.claim.decide'] = {
  ...STAFF,
  fn: (ctx, d) => P.lock(() => {
    const c = P.db.all('Claims').find((x) => x.id === d.id && x.status === 'pending');
    if (!c) fail('Request not found.', 'NOT_FOUND');
    if (d.decision === 'approve') {
      const app = P.db.all('Applications').find((a) => a.application_no === c.application_no);
      const ap = app && P.db.all('Applicants').find((a) => a.id === app.applicant_id);
      if (!ap || !ap.legacy) fail('That application number is not an imported record.', 'INVALID');
      moveApplicant(ap.id, c.user_id);
      P.db.update('Claims', c.id, { status: 'approved', decided_by: ctx.user.id, decided_at: isoNow() });
      queueMail(c.user_id, 'claim_approved', 'Your record is linked',
        mailText(['Your existing scholarship record ' + c.application_no + ' is now linked to your account.', 'Please sign in to see it.']));
    } else {
      P.db.update('Claims', c.id, { status: 'rejected', decided_by: ctx.user.id, decided_at: isoNow() });
      queueMail(c.user_id, 'claim_rejected', 'We could not link your record',
        mailText(['We could not link the record you asked for. Please contact the scholarship office.']));
    }
    audit(ctx.user, 'claim.' + (d.decision === 'approve' ? 'approved' : 'rejected'), 'claim', c.id);
    return { ok: true };
  }),
};

// ---- one-time import (master admin). Rows are plain objects; the CLI maps the committee's sheets to these.
const IMPORT_APP_FIELDS = {
  course: 'short', subject: 'short', category: CATEGORIES, course_type: COURSE_TYPES, stream: 'short', duration_years: 'n',
  year_of_study: 'n', completion_month: 'month', university: 'short', college: 'short', last_exam: 'short',
  last_exam_year: 'n', last_percentage: 'n', referred_by: 'short', referrer_designation: 'short', referrer_zone: 'short',
  referrer_contact: 'short', wisdom_district: 'short', grade: 'short', fund_type: FUND_TYPES, monthly_amount: 'n', score: 'n',
};

function cycleForYear(year, cache) {
  const y = Number(year);
  if (!Number.isInteger(y)) return null;
  if (cache[y]) return cache[y];
  let c = P.db.all('Cycles').find((x) => x.year === y);
  if (!c) {
    c = { id: P.uuid(), code: String(y).slice(2), name: 'Scheme ' + y, year: y, is_open: false, closes_on: '', next_serial: 1 };
    P.db.insert('Cycles', c);
  }
  cache[y] = c;
  return c;
}

function importPeople(rows) {
  const existing = new Set(P.db.all('Applications').map((a) => a.application_no));
  const cache = {};
  const users = [];
  const people = [];
  const apps = [];
  const skipped = [];
  rows.forEach((r) => {
    const no = clean(r.application_no, 20);
    if (!no) return skipped.push({ application_no: '', reason: 'No application number' });
    if (existing.has(no)) return skipped.push({ application_no: no, reason: 'Already exists' });
    const cycle = cycleForYear(r.scheme_year, cache);
    if (!cycle) return skipped.push({ application_no: no, reason: 'No scheme year' });
    let ac;
    try {
      ac = pickFields(r, IMPORT_APP_FIELDS);
    } catch (e) {
      return skipped.push({ application_no: no, reason: e.message });
    }
    const status = STATUSES.includes(r.status) ? r.status : 'active';
    const id = P.uuid();
    existing.add(no);
    users.push(newUser('', clean(r.name, 100), { id, active: true }));
    people.push({
      id, full_name: clean(r.name, 100), gender: GENDERS.includes(r.gender) ? r.gender : '', dob: '', district: clean(r.district, 60),
      address: '', phone: clean(r.mobile, 20), whatsapp: clean(r.whatsapp, 20), guardian_name: clean(r.guardian_name, 100),
      guardian_phone: clean(r.guardian_phone, 20), guardian_occupation: '', family_income: null,
      claim_email: normEmail(r.claim_email), legacy: true, updated_at: isoNow(),
    });
    apps.push(Object.assign({
      id: P.uuid(), applicant_id: id, cycle_id: cycle.id, scheme_year: String(cycle.year), application_no: no, status,
      status_note: clean(r.status_note, 200), submitted_at: isoNow(), created_at: isoNow(), updated_at: isoNow(),
    }, ac));
  });
  bulkInsert('Users', users);
  bulkInsert('Applicants', people);
  bulkInsert('Applications', apps);
  return { created: apps.length, skipped };
}

function importVerifications(rows) {
  const byNo = {};
  P.db.all('Applications').forEach((a) => { byNo[a.application_no] = a; });
  const have = new Set(P.db.all('Verifications').map((v) => v.application_id));
  const out = [];
  const skipped = [];
  rows.forEach((r) => {
    const app = byNo[clean(r.application_no, 20)];
    if (!app) return skipped.push({ application_no: clean(r.application_no, 20), reason: 'Application not found' });
    if (have.has(app.id)) return skipped.push({ application_no: app.application_no, reason: 'Already has a verification' });
    let f;
    try {
      f = pickFields(r, VERIFY_FIELDS);
    } catch (e) {
      return skipped.push({ application_no: app.application_no, reason: e.message });
    }
    have.add(app.id);
    out.push(Object.assign({
      id: P.uuid(), application_id: app.id, verifier_id: '', assigned_by: '', assigned_at: '', due_on: '', status: 'submitted',
      submitted_at: clean(r.submitted_at, 30) || isoNow(), on_behalf: false,
    }, f));
    if (f.wisdom_district && !app.wisdom_district) P.db.update('Applications', app.id, { wisdom_district: f.wisdom_district });
  });
  bulkInsert('Verifications', out);
  return { created: out.length, skipped };
}

function importBank(rows) {
  const byNo = {};
  P.db.all('Applications').forEach((a) => { byNo[a.application_no] = a; });
  const have = new Set(P.db.all('BankAccounts').map((b) => b.application_id));
  const out = [];
  const skipped = [];
  rows.forEach((r) => {
    const app = byNo[clean(r.application_no, 20)];
    if (!app) return skipped.push({ application_no: clean(r.application_no, 20), reason: 'Application not found' });
    if (have.has(app.id)) return skipped.push({ application_no: app.application_no, reason: 'Already has bank details' });
    const account = clean(r.account_no, 30).replace(/\s+/g, '');
    const ifsc = clean(r.ifsc, 15).toUpperCase().replace(/\s+/g, '');
    if (!/^\d{9,18}$/.test(account)) return skipped.push({ application_no: app.application_no, reason: 'Account number is not a plain 9 to 18 digit number' });
    if (!/^[A-Z]{4}0[A-Z0-9]{6}$/.test(ifsc)) return skipped.push({ application_no: app.application_no, reason: 'IFSC is not valid' });
    have.add(app.id);
    out.push({
      id: P.uuid(), application_id: app.id, holder: clean(r.holder, 100), account_no: account, bank: clean(r.bank, 80), ifsc,
      branch: clean(r.branch, 80), status: 'submitted', note: 'Imported, please verify', updated_at: isoNow(),
    });
  });
  bulkInsert('BankAccounts', out);
  return { created: out.length, skipped };
}

function importPayments(rows) {
  const byNo = {};
  P.db.all('Applications').forEach((a) => { byNo[a.application_no] = a; });
  const batches = {};
  P.db.all('PaymentBatches').forEach((b) => { batches[b.name] = b; });
  const out = [];
  const skipped = [];
  rows.forEach((r) => {
    const app = byNo[clean(r.application_no, 20)];
    if (!app) return skipped.push({ application_no: clean(r.application_no, 20), reason: 'Application not found' });
    const amount = Number(r.amount);
    const status = ['paid', 'failed'].includes(r.status) ? r.status : 'pending';
    if (!Number.isFinite(amount) || amount <= 0) return skipped.push({ application_no: app.application_no, reason: 'Amount is not valid' });
    const name = clean(r.batch, 80) || 'Imported payments';
    if (!batches[name]) {
      batches[name] = { id: P.uuid(), name, start_month: '', months: 0, status: 'sent', created_by: '', created_at: isoNow() };
      P.db.insert('PaymentBatches', batches[name]);
    }
    out.push({
      id: P.uuid(), batch_id: batches[name].id, application_id: app.id, amount, months: Number(r.months) || 0,
      fund_type: FUND_TYPES.includes(app.fund_type) ? app.fund_type : '', status, reference: '', paid_on: '', note: 'imported', created_at: isoNow(),
    });
  });
  bulkInsert('Payments', out);
  return { created: out.length, skipped };
}

ACTIONS['admin.import'] = {
  ...MASTER,
  fn: (ctx, d) => P.lock(() => {
    const rows = Array.isArray(d.rows) ? d.rows.slice(0, 200) : [];
    if (rows.length === 0) fail('There are no rows to import.', 'INVALID');
    const run = { people: importPeople, verifications: importVerifications, bank: importBank, payments: importPayments }[d.kind];
    if (!run) fail('Unknown import type.', 'INVALID');
    const result = run(rows);
    audit(ctx.user, 'import.' + d.kind, 'import', d.kind, { created: result.created, skipped: result.skipped.length });
    return result;
  }),
};

// ---- core/50_mail.js
/* Email. Sign-in codes go out immediately. Everything else is queued in the Outbox and sent in
   batches within the daily limit and only between 07:00 and 21:00 India time. */

const MAIL_RESERVE = 10; // keep some of the daily limit for sign-in codes

function mailText(lines) {
  return lines.join('\n\n') + '\n\nWISDOM Students VIDYANIDHI Scholarship Programme\nKerala State Committee';
}

function sendNow(to, subject, body) {
  if (P.mail.quota() < 1) fail('The daily email limit has been reached. Please try again tomorrow.', 'QUOTA');
  P.mail.send(to, subject, body);
}

function queueMail(userId, kind, subject, body) {
  const u = findUserById(userId);
  if (!u) return;
  P.db.insert('Outbox', {
    id: P.uuid(), user_id: userId, to: u.email, kind, subject, body, status: 'queued', error: '',
    created_at: isoNow(), sent_at: '',
  });
}

function jobFlushOutbox() {
  const hour = istHour();
  if (hour < 7 || hour >= 21) return { sent: 0, skipped: 'night' };
  return P.lock(() => {
    let room = P.mail.quota() - MAIL_RESERVE;
    let sent = 0;
    const queued = P.db.all('Outbox').filter((r) => r.status === 'queued')
      .sort((a, b) => (a.created_at < b.created_at ? -1 : 1));
    for (const row of queued) {
      if (room <= 0) break;
      try {
        P.mail.send(row.to, row.subject, row.body);
        P.db.update('Outbox', row.id, { status: 'sent', sent_at: isoNow(), error: '' });
        sent++;
        room--;
      } catch (e) {
        P.db.update('Outbox', row.id, { status: 'failed', error: clean(e && e.message, 200) });
      }
    }
    return { sent };
  });
}

// Reminders: 3 days before, on the due date, then every 3 days when overdue (up to 3 times).
// After the last reminder the item is flagged so an admin can phone the applicant.
function jobReminders() {
  const today = istDate();
  const apps = {};
  P.db.all('Applications').forEach((a) => { apps[a.id] = a; });
  let queued = 0;
  P.lock(() => {
    P.db.all('Pending').filter((p) => p.status === 'open' && p.due_on && p.last_reminder !== today).forEach((p) => {
      const days = daysBetween(today, p.due_on);
      const patch = {};
      let send = false;
      if (days === 3 || days === 0) send = true;
      else if (days < 0 && p.reminders < 3 && (-days) % 3 === 0) {
        send = true;
        patch.reminders = p.reminders + 1;
        if (patch.reminders >= 3) patch.flag = 'call';
      }
      if (!send) return;
      const app = apps[p.application_id];
      if (!app) return;
      const when = days > 0 ? 'is due in ' + days + ' days' : days === 0 ? 'is due today' : 'is overdue';
      queueMail(app.applicant_id, 'reminder', 'Reminder: ' + p.title,
        mailText(['This is a reminder that "' + p.title + '" ' + when + ' (due ' + p.due_on + ').',
          'Please sign in to the portal to complete it.']));
      patch.last_reminder = today;
      P.db.update('Pending', p.id, patch);
      queued++;
    });
  });
  return { queued };
}

// ---- core/90_router.js
/* Single entry point. Body: { action, token, data }. Reply: { ok, data } or { ok:false, error, code }. */

function handle(body) {
  try {
    const def = body && ACTIONS[body.action];
    if (!def) fail('Unknown request.', 'BAD_REQUEST');
    const ctx = { user: null, via: null };
    if (!def.pub) {
      const session = authenticate(body.token);
      ctx.user = session.user;
      ctx.via = session.via;
      if (def.roles && !def.roles.includes(ctx.user.role)) fail('Not allowed.', 'FORBIDDEN');
      if (def.staff && !isStaffCtx(ctx)) fail('Not allowed.', 'FORBIDDEN');
      if (def.master && ctx.user.role !== 'master') fail('Only the master admin can do this.', 'FORBIDDEN');
      if (def.finance && !(ctx.user.role === 'master' || ctx.user.finance)) fail('This needs the finance permission.', 'FORBIDDEN');
    }
    return { ok: true, data: def.fn(ctx, body.data || {}) };
  } catch (e) {
    if (e instanceof ApiError) return { ok: false, error: e.message, code: e.code };
    P.log('ERROR', e && e.stack ? e.stack : String(e));
    return { ok: false, error: 'Something went wrong. Please try again.', code: 'SERVER' };
  }
}

// ---- gas/entry.gs
/* Web app entry points, one-time setup and scheduled jobs. */

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function doGet() {
  return json_({ ok: true, service: 'vidyanidhi-api' });
}

function doPost(e) {
  let body = {};
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ ok: false, error: 'Bad request', code: 'BAD_REQUEST' });
  }
  return json_(handle(body));
}

/* Run this once from the editor (select "setup" and press Run). Safe to run again after an update:
   it only adds what is missing. */
function setup() {
  const props = PropertiesService.getScriptProperties();

  let ss;
  const existing = props.getProperty('SHEET_ID');
  if (existing) ss = SpreadsheetApp.openById(existing);
  else {
    ss = SpreadsheetApp.create('Vidyanidhi Database (edit through the portal, not by hand)');
    props.setProperty('SHEET_ID', ss.getId());
  }
  ['SESSION_SECRET', 'PEPPER'].forEach((k) => {
    if (!props.getProperty(k)) props.setProperty(k, Utilities.getUuid() + Utilities.getUuid());
  });
  if (!props.getProperty('FOLDER_ID')) props.setProperty('FOLDER_ID', DriveApp.createFolder('Vidyanidhi Documents').getId());
  if (!props.getProperty('BACKUP_FOLDER_ID')) props.setProperty('BACKUP_FOLDER_ID', DriveApp.createFolder('Vidyanidhi Backups').getId());

  Object.keys(SCHEMA).forEach((name) => {
    const cols = Object.keys(SCHEMA[name]);
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (sh.getMaxColumns() < cols.length) sh.insertColumnsAfter(sh.getMaxColumns(), cols.length - sh.getMaxColumns());
    const have = sh.getLastColumn() ? sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String).filter(String) : [];
    cols.filter((c) => have.indexOf(c) < 0).forEach((c) => {
      sh.getRange(1, have.length + 1).setValue(c);
      have.push(c);
    });
    sh.getRange(1, 1, sh.getMaxRows(), sh.getMaxColumns()).setNumberFormat('@');
    sh.getRange(1, 1, 1, have.length).setFontWeight('bold').setBackground('#d9f5ea');
    sh.setFrozenRows(1);
  });
  const blank = ss.getSheetByName('Sheet1');
  if (blank && ss.getSheets().length > 1) ss.deleteSheet(blank);

  seedData(Session.getEffectiveUser().getEmail());

  ScriptApp.getProjectTriggers().forEach((t) => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('jobFlushOutbox').timeBased().everyMinutes(15).create();
  ScriptApp.newTrigger('jobReminders').timeBased().everyDays(1).atHour(9).create();
  ScriptApp.newTrigger('jobBackup').timeBased().onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(2).create();

  console.log('Setup done. Database: ' + ss.getUrl());
  console.log('Master admin (first Google sign-in): ' + Session.getEffectiveUser().getEmail());
  console.log('Next: Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone) and copy the URL.');
}

/* Weekly copy of the database into the backup folder; keeps the last 8 copies. */
function jobBackup() {
  const props = PropertiesService.getScriptProperties();
  const folder = DriveApp.getFolderById(props.getProperty('BACKUP_FOLDER_ID'));
  const stamp = Utilities.formatDate(new Date(), 'Asia/Kolkata', 'yyyy-MM-dd');
  DriveApp.getFileById(props.getProperty('SHEET_ID')).makeCopy('Vidyanidhi backup ' + stamp, folder);
  const copies = [];
  const it = folder.getFiles();
  while (it.hasNext()) copies.push(it.next());
  copies.sort((a, b) => b.getDateCreated() - a.getDateCreated()).slice(8).forEach((f) => f.setTrashed(true));
}

// ---- gas/platform.gs
/* Google Apps Script platform: Sheets = database, Drive = documents, Gmail = email.
   This file is appended after backend/core/*.js by `npm run backend:bundle`. */

const P = (() => {
  const props = PropertiesService.getScriptProperties();
  const cache = CacheService.getScriptCache();
  const tables = {}; // per-request copy of each sheet
  let spreadsheet = null;
  let lockDepth = 0;

  const sheetOf = (name) => {
    spreadsheet = spreadsheet || SpreadsheetApp.openById(props.getProperty('SHEET_ID'));
    const sh = spreadsheet.getSheetByName(name);
    if (!sh) throw new Error('Missing sheet ' + name + '. Run setup() once.');
    return sh;
  };

  const fromCell = (v, type) => {
    if (v instanceof Date) v = v.toISOString();
    if (type === 'b') return v === true || String(v).toUpperCase() === 'TRUE';
    if (type === 'n') {
      if (v === '' || v === null || v === undefined) return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    }
    return v === null || v === undefined ? '' : String(v);
  };
  const toCell = (v, type) => {
    if (type === 'b') return v ? 'TRUE' : 'FALSE';
    if (v === null || v === undefined || v === '') return '';
    return String(v);
  };

  // Columns are matched by header name, so the sheet can be reordered or extended safely.
  const load = (name) => {
    if (tables[name]) return tables[name];
    const sh = sheetOf(name);
    const schema = SCHEMA[name];
    const width = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, width).getValues()[0].map(String);
    const last = sh.getLastRow();
    const values = last > 1 ? sh.getRange(2, 1, last - 1, width).getValues() : [];
    const rows = values.map((r) => {
      const o = {};
      Object.keys(schema).forEach((c) => {
        const i = headers.indexOf(c);
        o[c] = fromCell(i < 0 ? '' : r[i], schema[c]);
      });
      return o;
    });
    return (tables[name] = { sh, schema, headers, rows });
  };

  const rowValues = (t, obj) => t.headers.map((h) => (t.schema[h] ? toCell(obj[h], t.schema[h]) : ''));
  const writeRow = (t, index, obj) => {
    const range = t.sh.getRange(index + 2, 1, 1, t.headers.length);
    range.setNumberFormat('@'); // keep every value as text so Sheets never reinterprets dates
    range.setValues([rowValues(t, obj)]);
  };

  const lock = (fn) => {
    if (lockDepth > 0) return fn();
    const l = LockService.getScriptLock();
    l.waitLock(25000);
    lockDepth = 1;
    Object.keys(tables).forEach((k) => delete tables[k]); // another request may have written meanwhile
    try {
      return fn();
    } finally {
      lockDepth = 0;
      l.releaseLock();
    }
  };

  return {
    isDev: false,
    now: () => new Date(),
    uuid: () => Utilities.getUuid(),
    secret: (k) => props.getProperty(k),
    b64e: (s) => Utilities.base64Encode(s, Utilities.Charset.UTF_8),
    b64d: (s) => Utilities.newBlob(Utilities.base64Decode(s)).getDataAsString(),
    hmacB64: (key, msg) => Utilities.base64Encode(Utilities.computeHmacSha256Signature(msg, key)),
    sha256B64: (s) => Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s)),
    randomCode: (n) => {
      const hex = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '').slice(0, 12);
      return String(parseInt(hex, 16) % Math.pow(10, n)).padStart(n, '0');
    },
    log: (...a) => console.error(a.join(' ')),
    lock,
    cache: {
      get: (k) => cache.get(k),
      put: (k, v, s) => cache.put(k, v, Math.min(s || 600, 21600)),
    },
    db: {
      all: (name) => load(name).rows.map((r) => Object.assign({}, r)),
      insert: (name, obj) => lock(() => {
        const t = load(name);
        const row = {};
        Object.keys(t.schema).forEach((c) => { row[c] = obj[c] === undefined ? fromCell('', t.schema[c]) : obj[c]; });
        writeRow(t, t.rows.length, row);
        t.rows.push(row);
      }),
      // One range write for many rows (imports); far faster than inserting one by one.
      insertMany: (name, objs) => lock(() => {
        if (objs.length === 0) return;
        const t = load(name);
        const rows = objs.map((obj) => {
          const row = {};
          Object.keys(t.schema).forEach((c) => { row[c] = obj[c] === undefined ? fromCell('', t.schema[c]) : obj[c]; });
          return row;
        });
        const range = t.sh.getRange(t.rows.length + 2, 1, rows.length, t.headers.length);
        range.setNumberFormat('@');
        range.setValues(rows.map((r) => rowValues(t, r)));
        rows.forEach((r) => t.rows.push(r));
      }),
      update: (name, id, patch) => lock(() => {
        const t = load(name);
        const i = t.rows.findIndex((r) => r.id === id);
        if (i < 0) throw new Error('No ' + name + ' row ' + id);
        Object.keys(patch).forEach((c) => { if (t.schema[c]) t.rows[i][c] = patch[c]; });
        writeRow(t, i, t.rows[i]);
      }),
      remove: (name, id) => lock(() => {
        const t = load(name);
        const i = t.rows.findIndex((r) => r.id === id);
        if (i < 0) return;
        t.sh.deleteRow(i + 2);
        delete tables[name];
      }),
    },
    mail: {
      quota: () => MailApp.getRemainingDailyQuota(),
      send: (to, subject, body) => MailApp.sendEmail({ to, subject, body, name: 'Wisdom Students Vidyanidhi' }),
    },
    files: {
      save: (owner, name, mime, b64) => {
        const root = DriveApp.getFolderById(props.getProperty('FOLDER_ID'));
        const found = root.getFoldersByName(owner);
        const folder = found.hasNext() ? found.next() : root.createFolder(owner);
        const file = folder.createFile(Utilities.newBlob(Utilities.base64Decode(b64), mime, name));
        file.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.NONE);
        return file.getId();
      },
      read: (id, name, mime) => {
        const blob = DriveApp.getFileById(id).getBlob();
        return { name, mime, data: Utilities.base64Encode(blob.getBytes()) };
      },
    },
    // Checks the Google sign-in token with Google and confirms it was issued for our client ID.
    verifyGoogleIdToken: (credential) => {
      const clientId = props.getProperty('GOOGLE_CLIENT_ID');
      if (!clientId) throw new Error('GOOGLE_CLIENT_ID is not set');
      const res = UrlFetchApp.fetch(
        'https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(credential),
        { muteHttpExceptions: true });
      if (res.getResponseCode() !== 200) throw new Error('token rejected');
      const t = JSON.parse(res.getContentText());
      const issuers = ['accounts.google.com', 'https://accounts.google.com'];
      if (t.aud !== clientId || issuers.indexOf(t.iss) < 0 || String(t.email_verified) !== 'true' || Number(t.exp) < Date.now() / 1000) {
        throw new Error('token not valid for this app');
      }
      return { email: t.email, name: t.name || '' };
    },
  };
})();
